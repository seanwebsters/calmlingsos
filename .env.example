# ---------------------------------------------------------------------------
# CALMLINGS OS – environment. Copy to .env.local (dev) or set on your host.
# Secrets are read on the server only and never sent to the browser.
# ---------------------------------------------------------------------------

# Database. PostgreSQL in production. Leave unset to use the embedded PGlite
# database persisted in DATA_DIR (fine for local work and evaluation).
DATABASE_URL=postgres://calmlings:calmlings@localhost:5432/calmlings_os
DATABASE_POOL_SIZE=10

# Where local files (and PGlite) live. Mount a persistent volume here.
DATA_DIR=.data

# Sign-in: "open" (default, no login – everyone with the URL is the owner) or "required".
AUTH_MODE=open

# REQUIRED in production: signs session cookies and asset URLs (openssl rand -hex 32).
APP_SECRET=

# 32 random bytes (hex) – enables encrypted storage of provider keys entered in Settings.
# Without it, provider keys can only come from the environment variables below.
CREDENTIALS_ENCRYPTION_KEY=

# Object storage: "local" (DATA_DIR/storage) or "s3" (any S3-compatible store: AWS S3, R2, MinIO).
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# AI providers (optional; environment keys take precedence over keys stored in Settings).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
FAL_KEY=
ELEVENLABS_API_KEY=

# Background jobs. The web process runs a worker by default; set "off" and run
# `npm run worker` processes separately for larger deployments.
IN_PROCESS_WORKER=on
WORKER_CONCURRENCY=3

# Optional ClamAV daemon (host:port) for malware scanning of uploads.
CLAMAV_ADDRESS=

# Optional: override bundled binaries.
FFMPEG_PATH=
FFPROBE_PATH=

# Local HTTP only: allow session cookies without HTTPS when NODE_ENV=production.
INSECURE_COOKIES=
